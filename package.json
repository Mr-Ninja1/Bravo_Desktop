{
  "name": "checklistapp-desktop",
  "version": "0.0.3",
  "description": "Minimal Electron app to preview and export mobile-saved forms",
  "main": "main.js",
  "author": "RAJAB CULTURE DIGITAL SOLUTIONS <kulturesik30@gmail.com>",
  "scripts": {
    "start": "electron .",
    "build-renderer": "node build-renderer.js",
    "dev:watch": "npx esbuild renderer/react-entry.jsx --bundle --outfile=renderer/dist/bundle.js --platform=browser --sourcemap --loader:.js=jsx --watch --define:process.env.NODE_ENV=\"development\"",
    "dev:electron": "electron .",
    "dev": "npx concurrently \"npm run dev:watch\" \"npm run dev:electron\"",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.18.20",
    "concurrently": "^8.0.1",
    "electron-reload": "^1.5.0"
  },
  "build": {
    "appId": "com.example.checklistapp",
    "productName": "Bravo_FormsApp",
    "copyright": "Copyright © RAJAB CULTURE DIGITAL SOLUTIONS",
      "win": {
        "target": [
          "nsis"
        ]
        ,"icon": "assets/bravo.ico"
      },
    "icon": "assets/bravo.ico",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mr-Ninja1",
        "repo": "Bravo_Desktop"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^4.6.5",
    "keytar": "7.9.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native-signature-canvas": "^5.0.1",
    "react-native-web": "^0.21.2"
  }
}
