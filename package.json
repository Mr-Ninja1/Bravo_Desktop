        "owner": "GITHUB_OWNER",
        "repo": "GITHUB_REPO"
      }
    ]
  },
  "dependencies": {
    "keytar": "7.9.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native-web": "^0.21.2"
  }
}
