{
  "name": "checklistapp-desktop",
  "version": "0.0.1",
  "description": "Minimal Electron app to preview and export mobile-saved forms",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-renderer": "node build-renderer.js"
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "esbuild": "^0.18.20"
  },
  "build": {
